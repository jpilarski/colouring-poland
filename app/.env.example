# ==============================================================================
# Colouring Poland – Wzorcowy plik zmiennych środowiskowych (.env.example)
# Skopiuj ten plik jako .env w katalogu app/ i uzupełnij wartości właściwe
# dla swojego środowiska (lokalnego lub serwera produkcyjnego PP).
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Konfiguracja serwera aplikacji Express
# ------------------------------------------------------------------------------
PORT=tbd
NODE_ENV=development

# Tajny klucz do podpisywania ciasteczek sesyjnych (cp.session / connect-pg-simple)
# W środowisku produkcyjnym wygeneruj długi, losowy ciąg znaków (np. openssl rand -hex 32)
APP_COOKIE_SECRET=tbd

# Publiczny URL aplikacji – używany m.in. do generowania linków aktywacyjnych i resetu haseł w mailach
WEBAPP_ORIGIN=tbd

# ------------------------------------------------------------------------------
# 2. Połączenie z bazą danych PostgreSQL + PostGIS
# ------------------------------------------------------------------------------
PGHOST=tbd
PGPORT=tbd
PGDATABASE=tbd
PGUSER=tbd
PGPASSWORD=tbd

# ------------------------------------------------------------------------------
# 3. Serwer kafelków mapowych (Mapnik + Sharp + Cache dyskowy)
# ------------------------------------------------------------------------------
# Ścieżka do katalogu na dysku, w którym składowane będą wygenerowane kafelki mapy
# Na serwerze produkcyjnym Linux zaleca się np. /var/cache/colouring-tiles
TILECACHE_PATH=tbd

# Przełączniki cache'owania kafelków (true / false)
CACHE_TILES=true
CACHE_DATA_TILES=true

# ------------------------------------------------------------------------------
# 4. Serwer pocztowy SMTP (Nodemailer – reset haseł, powiadomienia, aktywacja)
# ------------------------------------------------------------------------------
MAIL_SERVER_HOST=tbd
MAIL_SERVER_PORT=tbd
MAIL_SERVER_USER=tbd
MAIL_SERVER_PASSWORD=tbd
MAIL_FROM=tbd
